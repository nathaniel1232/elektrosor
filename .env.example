# Supabase — required
# Find these in Supabase → Project Settings → API → "Project URL" and "Publishable key"
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=sb_publishable_...

# OpenAI — required for the chatbot
# Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Installer — for å sende bestillinger videre til Installer-systemet.
# Dokumentasjon: https://docs.installer.com  (autentisering: Bearer-token)
# Hvis API_URL/API_KEY ikke er satt blir bestillinger fortsatt lagret lokalt, men ikke sendt videre.
INSTALLER_API_URL=https://api.installer.com/api/v1/order
INSTALLER_API_KEY=
# Valgfri arbeidsflyt — settes kun hvis Installer-kontoen krever en bestemt workflow.
# INSTALLER_WORKFLOW_ID=
# Webhook-signatur er foreløpig ikke dokumentert hos Installer — la stå tom til
# verifiseringsmetoden er bekreftet med supporten deres.
INSTALLER_WEBHOOK_SECRET=
